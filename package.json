{
  "name": "agent-skills",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "eval": "npm run eval --workspace=redis-development-build --",
    "eval:aggregate": "npm run eval:aggregate --workspace=redis-development-build --",
    "eval:baseline": "npm run eval:baseline --workspace=redis-development-build --",
    "validate": "npm run validate:plugins && npm run validate:skill-structure",
    "validate:skill-structure": "node scripts/validate-skill-structure.mjs --all --enforce",
    "validate:claude-plugins": "node scripts/validate-claude-plugins.mjs",
    "validate:cursor-plugins": "node scripts/validate-cursor-plugins.mjs",
    "validate:plugins": "npm run validate:claude-plugins && npm run validate:cursor-plugins",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
